{
  "expo": {
    "name": "Kaquiz",
    "slug": "kaquiz",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "kaquiz",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2F6EF",
    "ios": {
      "bundleIdentifier": "com.reboot01.kaquiz",
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.reboot01.kaquiz",
      "adaptiveIcon": {
        "backgroundColor": "#F2F6EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kaquiz to share your location with accepted friends while the app is open."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10231E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
