# iOS simulator/web on this Mac: http://localhost:3000/api
# Android emulator: http://10.0.2.2:3000/api
# Physical devices: use this Mac's LAN IP, for example http://192.168.1.10:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Public Google OAuth IDs. Leave empty to hide Google sign-in.
# Use a WEB client ID here on every platform (also configure the server audience).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=650136318399-bb0p0hkvubvg46hm2kob1g50ja2p1526.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=650136318399-40lgba5pokpv30phdvlo80obbvpfj6j0.apps.googleusercontent.com
# Reversed iOS client ID, used by app.config.js during native builds.
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.650136318399-40lgba5pokpv30phdvlo80obbvpfj6j0
